    Gst.CessRate,
    @Semantics.amount.currencyCode: 'tcurr'
    Gst.cgstamt,
    @Semantics.amount.currencyCode: 'tcurr'
    Gst.sgstamt,
    @Semantics.amount.currencyCode: 'tcurr'
    Gst.igstamt,
    @Semantics.amount.currencyCode: 'tcurr'
