    Gl.ReferenceDocumentItemGroup,
    Gl.TransactionSubitem,
    Gl.OffsettingLedgerGLLineItem,
    Gl.IsReversal,
    Gl.IsReversed,
    Gl.ReversalReferenceDocumentCntxt,
    Gl.ReversalReferenceDocument,
   
    Gst.COCD,
